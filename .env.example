# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Environment
NEXT_PUBLIC_ENV=development

# Google Analytics 4 (Measurement ID — https://analytics.google.com)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-0W2ZPW2N8C

# Chave AES-256 (32 bytes) para cifrar o token do Instagram em sm_instagram_accounts.
# Gere com: openssl rand -base64 32   (só usada em rotas de servidor)
ENCRYPTION_KEY=

# URL publica canonica do site (sem barra final) - usada em canonical, sitemap, robots e Open Graph
NEXT_PUBLIC_SITE_URL=https://www.isoscanning.com

# ── Suporte por plano (docs/plan-gating.md no backend) ──
# WhatsApp do suporte prioritário (Ultra), só dígitos com DDI: 5511999999999
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# E-mail de suporte (Pro). Default: isoscanning@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Agenda: sincronização com calendários (docs/agenda-sync.md) ──
# Google Agenda por OAuth (credencial "Aplicativo da Web" no Google Cloud;
# redirect: https://SEU_DOMINIO/api/agenda/google/callback). Sem elas, a tela
# oferece só a conexão por link .ics (iCloud/Outlook/Google), que já funciona.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Opcional: força a URL de callback (normalmente detectada pelos headers do proxy)
GOOGLE_CALENDAR_REDIRECT_URI=
# Segredo do cron (/api/agenda/cron-sync e /api/social-media/instagram/cron-sync).
# Gere com: openssl rand -hex 32
CRON_SECRET=


# Vagas do mercado (SQL 83) — APIs OFICIAIS de vagas; sem a chave a fonte fica
# desligada. Cron: .github/workflows/external-jobs.yml → /api/vagas-externas/cron-import
# Jooble: chave grátis em https://br.jooble.org/api/about
JOOBLE_API_KEY=
# Opcional (padrão br.jooble.org) e filtro de local da busca (vazio = Brasil todo)
JOOBLE_API_HOST=
JOOBLE_LOCATION=
# Adzuna: app grátis em https://developer.adzuna.com (país "br")
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Opcionais: nota da IA para publicar sozinha (padrão 70) / ir para revisão (45)
EXTERNAL_JOBS_PUBLISH_SCORE=
EXTERNAL_JOBS_REVIEW_SCORE=
# Dias mínimos entre avisos automáticos aos profissionais (padrão 3; 0 desliga)
EXTERNAL_JOBS_DIGEST_DAYS=
