# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Environment
NEXT_PUBLIC_ENV=development

# Google Analytics 4 (Measurement ID — https://analytics.google.com)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-0W2ZPW2N8C

# Chave AES-256 (32 bytes) para cifrar o token do Instagram em sm_instagram_accounts.
# Gere com: openssl rand -base64 32   (só usada em rotas de servidor)
ENCRYPTION_KEY=

# URL publica canonica do site (sem barra final) - usada em canonical, sitemap, robots e Open Graph
NEXT_PUBLIC_SITE_URL=https://www.isoscanning.com
